<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:zeebe="http://camunda.org/schema/zeebe/1.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:modeler="http://camunda.org/schema/modeler/1.0" id="Definitions_PBL2" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.49.0" modeler:executionPlatform="Camunda Cloud" modeler:executionPlatformVersion="8.9.0">
  <bpmn:error id="Error_PaymentLimit" name="ERR_PAYMENT_GATEWAY" errorCode="ERR_PAYMENT_GATEWAY" />
  <bpmn:process id="Process_EcommerceReturn_PBL2" name="E-Commerce Return and Refund Processing - PBL2" isExecutable="true">
    <bpmn:startEvent id="Start_ReturnRequest" name="Customer Submits&#10;Return Request">
      <bpmn:extensionElements>
        <zeebe:ioMapping>
          <zeebe:output source="=if is defined(returnItems) and count(returnItems) &#62; 0 then returnItems else [{&#34;sku&#34;: &#34;SKU-DEFAULT-01&#34;, &#34;productCategory&#34;: productCategory, &#34;itemPrice&#34;: itemPrice}]" target="returnItemsList" />
          <zeebe:output source="=productCategory" target="productCategory" />
          <zeebe:output source="=itemPrice" target="itemPrice" />
          <zeebe:output source="=daysSinceDelivery" target="daysSinceDelivery" />
          <zeebe:output source="=customerTier" target="customerTier" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:outgoing>Flow_Start_To_Fetch</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_FetchOrder" name="Fetch &#38; Verify&#10;Line Items (MI)">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="fetch-order-service" />
        <zeebe:ioMapping>
          <zeebe:input source="=currentItem.productCategory" target="itemCategory" />
          <zeebe:input source="=currentItem.itemPrice" target="lineItemPrice" />
          <zeebe:output source="=orderStatus" target="orderStatus" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Start_To_Fetch</bpmn:incoming>
      <bpmn:outgoing>Flow_Fetch_To_DMN</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics>
        <bpmn:extensionElements>
          <zeebe:loopCharacteristics inputCollection="=returnItemsList" inputElement="currentItem" outputCollection="verifiedItemsList" outputElement="=orderStatus" />
        </bpmn:extensionElements>
      </bpmn:multiInstanceLoopCharacteristics>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Start_To_Fetch" sourceRef="Start_ReturnRequest" targetRef="Task_FetchOrder" />
    <bpmn:businessRuleTask id="Task_EvaluateDMN" name="Evaluate Return &#38;&#10;Refund Policy (DMN)">
      <bpmn:extensionElements>
        <zeebe:calledDecision decisionId="Decision_ReturnPolicy_PBL2" resultVariable="refundDecision" />
        <zeebe:ioMapping>
          <zeebe:output source="=refundDecision" target="refundDecision" />
          <zeebe:output source="=refundDecision.restockingFee" target="restockingFee" />
          <zeebe:output source="=refundDecision.refundAction" target="policyDecision" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Fetch_To_DMN</bpmn:incoming>
      <bpmn:outgoing>Flow_DMN_To_Gateway</bpmn:outgoing>
    </bpmn:businessRuleTask>
    <bpmn:sequenceFlow id="Flow_Fetch_To_DMN" sourceRef="Task_FetchOrder" targetRef="Task_EvaluateDMN" />
    <bpmn:exclusiveGateway id="Gateway_Routing" name="Refund Routing&#10;Action?" default="Flow_Route_Inspect">
      <bpmn:incoming>Flow_DMN_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Route_Reject</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Inspect</bpmn:outgoing>
      <bpmn:outgoing>Flow_Route_Instant</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_DMN_To_Gateway" sourceRef="Task_EvaluateDMN" targetRef="Gateway_Routing" />
    <bpmn:sequenceFlow id="Flow_Route_Reject" name="Reject Request" sourceRef="Gateway_Routing" targetRef="End_ReturnRejected">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=refundDecision.refundAction = "Reject"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:subProcess id="SubProcess_Inspection" name="Warehouse Quality Inspection Sub-Process">
      <bpmn:incoming>Flow_Route_Inspect</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspect_To_Gateway</bpmn:outgoing>
      <bpmn:startEvent id="Start_SubInspect" name="Start&#10;Inspection">
        <bpmn:outgoing>Flow_Sub_1</bpmn:outgoing>
      </bpmn:startEvent>
      <bpmn:userTask id="Task_WarehouseInspect" name="Warehouse Item&#10;Quality Inspection">
        <bpmn:extensionElements>
          <zeebe:userTask />
          <zeebe:assignmentDefinition assignee="demo" />
          <zeebe:formDefinition formId="Form_WarehouseInspection" />
        </bpmn:extensionElements>
        <bpmn:incoming>Flow_Sub_1</bpmn:incoming>
        <bpmn:outgoing>Flow_Sub_2</bpmn:outgoing>
      </bpmn:userTask>
      <bpmn:endEvent id="End_SubInspect" name="Inspection&#10;Logged">
        <bpmn:incoming>Flow_Sub_2</bpmn:incoming>
      </bpmn:endEvent>
      <bpmn:sequenceFlow id="Flow_Sub_1" sourceRef="Start_SubInspect" targetRef="Task_WarehouseInspect" />
      <bpmn:sequenceFlow id="Flow_Sub_2" sourceRef="Task_WarehouseInspect" targetRef="End_SubInspect" />
    </bpmn:subProcess>
    <bpmn:sequenceFlow id="Flow_Route_Inspect" name="Inspection&#10;Required" sourceRef="Gateway_Routing" targetRef="SubProcess_Inspection" />
    <bpmn:boundaryEvent id="Boundary_TimerSLA" name="SLA Timer&#10;(PT24H)" cancelActivity="false" attachedToRef="SubProcess_Inspection">
      <bpmn:outgoing>Flow_Timer_To_Alert</bpmn:outgoing>
      <bpmn:timerEventDefinition id="TimerDef_SLA">
        <bpmn:timeDuration xsi:type="bpmn:tFormalExpression">PT24H</bpmn:timeDuration>
      </bpmn:timerEventDefinition>
    </bpmn:boundaryEvent>
    <bpmn:endEvent id="End_SLAEscalated" name="SLA Escalation&#10;Logged">
      <bpmn:incoming>Flow_Timer_To_Alert</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_Timer_To_Alert" sourceRef="Boundary_TimerSLA" targetRef="End_SLAEscalated" />
    <bpmn:exclusiveGateway id="Gateway_InspectionCheck" name="Inspection&#10;Passed?" default="Flow_Inspect_Failed">
      <bpmn:incoming>Flow_Inspect_To_Gateway</bpmn:incoming>
      <bpmn:outgoing>Flow_Inspect_Passed</bpmn:outgoing>
      <bpmn:outgoing>Flow_Inspect_Failed</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:sequenceFlow id="Flow_Inspect_To_Gateway" sourceRef="SubProcess_Inspection" targetRef="Gateway_InspectionCheck" />
    <bpmn:sequenceFlow id="Flow_Inspect_Failed" name="Failed" sourceRef="Gateway_InspectionCheck" targetRef="End_ReturnRejected" />
    <bpmn:serviceTask id="Task_DisburseRefund" name="Disburse Refund via&#10;Payment Gateway">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="payment-disbursement-worker" />
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Route_Instant</bpmn:incoming>
      <bpmn:incoming>Flow_Inspect_Passed</bpmn:incoming>
      <bpmn:outgoing>Flow_Disburse_To_ERP</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Route_Instant" name="Instant Refund&#10;(Keep Item)" sourceRef="Gateway_Routing" targetRef="Task_DisburseRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=refundDecision.refundAction = "Instant-Refund"</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Flow_Inspect_Passed" name="Passed" sourceRef="Gateway_InspectionCheck" targetRef="Task_DisburseRefund">
      <bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">=inspectionPassed = true</bpmn:conditionExpression>
    </bpmn:sequenceFlow>
    <bpmn:boundaryEvent id="Boundary_PaymentError" name="Gateway Error&#10;(ERR_PAYMENT)" attachedToRef="Task_DisburseRefund">
      <bpmn:outgoing>Flow_PaymentError_To_Rejected</bpmn:outgoing>
      <bpmn:errorEventDefinition id="ErrorDef_Payment" errorRef="Error_PaymentLimit" />
    </bpmn:boundaryEvent>
    <bpmn:sequenceFlow id="Flow_PaymentError_To_Rejected" name="Limit Exceeded" sourceRef="Boundary_PaymentError" targetRef="End_ReturnRejected" />
    <bpmn:serviceTask id="Task_UpdateERP" name="Update Order &#38;&#10;Inventory Records" zeebe:modelerTemplate="io.camunda.connectors.HttpJson.v2" zeebe:modelerTemplateVersion="13">
      <bpmn:extensionElements>
        <zeebe:taskDefinition type="io.camunda:http-json:1" retries="3" />
        <zeebe:ioMapping>
          <zeebe:input source="noAuth" target="authentication.type" />
          <zeebe:input source="POST" target="method" />
          <zeebe:input source="https://httpbin.org/post" target="url" />
          <zeebe:input source="=false" target="storeResponse" />
          <zeebe:input source="=false" target="followRedirects" />
          <zeebe:input source="=20" target="connectionTimeoutInSeconds" />
          <zeebe:input source="=20" target="readTimeoutInSeconds" />
          <zeebe:input source="{&#10;  &#34;orderStatus&#34;: &#34;CLOSED&#34;,&#10;  &#34;inventoryAction&#34;: &#34;RESTOCKED&#34;,&#10;  &#34;paymentStatus&#34;: &#34;SUCCESS&#34;&#10;}" target="body" />
          <zeebe:input source="=false" target="ignoreNullValues" />
        </zeebe:ioMapping>
        <zeebe:taskHeaders>
          <zeebe:header key="elementTemplateVersion" value="13" />
          <zeebe:header key="elementTemplateId" value="io.camunda.connectors.HttpJson.v2" />
          <zeebe:header key="resultVariable" value="inventorySyncResponse" />
          <zeebe:header key="resultExpression" value="={&#10;  myResponseBody: response.body&#10;}" />
          <zeebe:header key="retryBackoff" value="PT0S" />
        </zeebe:taskHeaders>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_Disburse_To_ERP</bpmn:incoming>
      <bpmn:outgoing>Flow_ERP_To_CallNotify</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sequenceFlow id="Flow_Disburse_To_ERP" sourceRef="Task_DisburseRefund" targetRef="Task_UpdateERP" />
    <bpmn:callActivity id="Call_NotifyCustomer" name="Dispatch Customer&#10;Notification (Child)">
      <bpmn:extensionElements>
        <zeebe:calledElement processId="Process_ChildNotification_PBL2" propagateAllChildVariables="false" />
        <zeebe:ioMapping>
          <zeebe:input source="=customerTier" target="recipientTier" />
          <zeebe:input source="=&#34;REFUND_SETTLED&#34;" target="notificationType" />
          <zeebe:input source="=&#34;Your refund has been processed and order closed.&#34;" target="notificationMessage" />
          <zeebe:input source="=netRefundAmount" target="refundAmount" />
          <zeebe:output source="=notificationDispatched" target="notificationDispatched" />
        </zeebe:ioMapping>
      </bpmn:extensionElements>
      <bpmn:incoming>Flow_ERP_To_CallNotify</bpmn:incoming>
      <bpmn:outgoing>Flow_CallNotify_To_End</bpmn:outgoing>
    </bpmn:callActivity>
    <bpmn:sequenceFlow id="Flow_ERP_To_CallNotify" sourceRef="Task_UpdateERP" targetRef="Call_NotifyCustomer" />
    <bpmn:endEvent id="End_ReturnRejected" name="Return Rejected&#10;&#38; Closed">
      <bpmn:incoming>Flow_Route_Reject</bpmn:incoming>
      <bpmn:incoming>Flow_Inspect_Failed</bpmn:incoming>
      <bpmn:incoming>Flow_PaymentError_To_Rejected</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:endEvent id="End_RefundCompleted" name="Refund Processed&#10;&#38; Order Closed">
      <bpmn:incoming>Flow_CallNotify_To_End</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_CallNotify_To_End" sourceRef="Call_NotifyCustomer" targetRef="End_RefundCompleted" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Process_EcommerceReturn_PBL2">
      <bpmndi:BPMNShape id="Start_ReturnRequest_di" bpmnElement="Start_ReturnRequest">
        <dc:Bounds x="142" y="242" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="122" y="285" width="78" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_FetchOrder_di" bpmnElement="Task_FetchOrder">
        <dc:Bounds x="230" y="220" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_EvaluateDMN_di" bpmnElement="Task_EvaluateDMN">
        <dc:Bounds x="385" y="220" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_Routing_di" bpmnElement="Gateway_Routing" isMarkerVisible="true">
        <dc:Bounds x="540" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="527" y="198" width="77" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="SubProcess_Inspection_di" bpmnElement="SubProcess_Inspection" isExpanded="true">
        <dc:Bounds x="635" y="190" width="275" height="140" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_SubInspect_di" bpmnElement="Start_SubInspect">
        <dc:Bounds x="657" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_WarehouseInspect_di" bpmnElement="Task_WarehouseInspect">
        <dc:Bounds x="720" y="220" width="105" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_SubInspect_di" bpmnElement="End_SubInspect">
        <dc:Bounds x="852" y="242" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Sub_1_di" bpmnElement="Flow_Sub_1">
        <di:waypoint x="693" y="260" />
        <di:waypoint x="720" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Sub_2_di" bpmnElement="Flow_Sub_2">
        <di:waypoint x="825" y="260" />
        <di:waypoint x="852" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNShape id="End_SLAEscalated_di" bpmnElement="End_SLAEscalated">
        <dc:Bounds x="832" y="362" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="815" y="403" width="73" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_InspectionCheck_di" bpmnElement="Gateway_InspectionCheck" isMarkerVisible="true">
        <dc:Bounds x="955" y="235" width="50" height="50" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="955" y="198" width="51" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_DisburseRefund_di" bpmnElement="Task_DisburseRefund">
        <dc:Bounds x="1050" y="330" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_UpdateERP_di" bpmnElement="Task_UpdateERP">
        <dc:Bounds x="1205" y="330" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Call_NotifyCustomer_di" bpmnElement="Call_NotifyCustomer">
        <dc:Bounds x="1360" y="330" width="110" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_ReturnRejected_di" bpmnElement="End_ReturnRejected">
        <dc:Bounds x="962" y="102" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="941" y="65" width="80" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_RefundCompleted_di" bpmnElement="End_RefundCompleted">
        <dc:Bounds x="1512" y="352" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1493" y="395" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_PaymentError_di" bpmnElement="Boundary_PaymentError">
        <dc:Bounds x="1102" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="1135" y="296" width="76" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Boundary_TimerSLA_di" bpmnElement="Boundary_TimerSLA">
        <dc:Bounds x="752" y="312" width="36" height="36" />
        <bpmndi:BPMNLabel>
          <dc:Bounds x="700" y="345" width="54" height="27" />
        </bpmndi:BPMNLabel>
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_Start_To_Fetch_di" bpmnElement="Flow_Start_To_Fetch">
        <di:waypoint x="178" y="260" />
        <di:waypoint x="230" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Fetch_To_DMN_di" bpmnElement="Flow_Fetch_To_DMN">
        <di:waypoint x="340" y="260" />
        <di:waypoint x="385" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_DMN_To_Gateway_di" bpmnElement="Flow_DMN_To_Gateway">
        <di:waypoint x="495" y="260" />
        <di:waypoint x="540" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Route_Reject_di" bpmnElement="Flow_Route_Reject">
        <di:waypoint x="565" y="235" />
        <di:waypoint x="565" y="120" />
        <di:waypoint x="962" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Route_Inspect_di" bpmnElement="Flow_Route_Inspect">
        <di:waypoint x="590" y="260" />
        <di:waypoint x="635" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Timer_To_Alert_di" bpmnElement="Flow_Timer_To_Alert">
        <di:waypoint x="770" y="348" />
        <di:waypoint x="770" y="380" />
        <di:waypoint x="832" y="380" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Inspect_To_Gateway_di" bpmnElement="Flow_Inspect_To_Gateway">
        <di:waypoint x="910" y="260" />
        <di:waypoint x="955" y="260" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Inspect_Failed_di" bpmnElement="Flow_Inspect_Failed">
        <di:waypoint x="980" y="235" />
        <di:waypoint x="980" y="138" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Route_Instant_di" bpmnElement="Flow_Route_Instant">
        <di:waypoint x="565" y="285" />
        <di:waypoint x="565" y="370" />
        <di:waypoint x="1050" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Inspect_Passed_di" bpmnElement="Flow_Inspect_Passed">
        <di:waypoint x="980" y="285" />
        <di:waypoint x="980" y="370" />
        <di:waypoint x="1050" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_PaymentError_To_Rejected_di" bpmnElement="Flow_PaymentError_To_Rejected">
        <di:waypoint x="1120" y="312" />
        <di:waypoint x="1120" y="120" />
        <di:waypoint x="998" y="120" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_Disburse_To_ERP_di" bpmnElement="Flow_Disburse_To_ERP">
        <di:waypoint x="1160" y="370" />
        <di:waypoint x="1205" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_ERP_To_CallNotify_di" bpmnElement="Flow_ERP_To_CallNotify">
        <di:waypoint x="1315" y="370" />
        <di:waypoint x="1360" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_CallNotify_To_End_di" bpmnElement="Flow_CallNotify_To_End">
        <di:waypoint x="1470" y="370" />
        <di:waypoint x="1512" y="370" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>